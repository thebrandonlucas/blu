## What blu.cx knows about its documents, in pure Roc, shared by the two
## programs that draw it: site.roc (folio), which writes every page as HTML
## and the data the app reads, and the roc-signals app under signals/,
## which draws the same pages in the browser. Neither platform is imported
## here, so both compilers build it.
package
	[
		Data,
		Dates,
		Route,
		Site,
		Text,
	]
	{}
